# Normalise line endings: the repository is LF everywhere, so a file
# regenerated on Windows matches the committed one.
* text=auto eol=lf

# Windows batch files must keep CRLF or cmd.exe mis-parses them.
*.bat text eol=crlf

# Never line-ending-convert binaries.
*.jar binary
*.png binary
*.jpg binary
*.webp binary
*.keystore binary
